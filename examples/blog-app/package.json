    "@forge/auth-plugin": "workspace:*",
    "@forge/events-plugin": "workspace:*",
    "sql.js": "^1.10.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "@types/sql.js": "^1.4.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/node": "^20.0.0"
  }
